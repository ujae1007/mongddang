<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mongddang.backend.profile.repository.ProfileRepository">

  <!-- ResultMap for Music -->
  <resultMap id="MusicResultMap" type="com.mongddang.backend.profile.dto.MusicDTO">
    <result property="trackName" column="trackName"/>
    <result property="artistName" column="artistName"/>
  </resultMap>
  
  <!-- ResultMap for Photo -->
  <resultMap id="PhotoResultMap" type="com.mongddang.backend.profile.dto.PhotoDTO">
    <id property="photoId" column="photoId"/>
    <result property="photoURL" column="photoURL"/>
    <result property="createdAt" column="photoCreatedAt"/>
  </resultMap>
  
  <!-- ResultMap for Playlist with nested Music and collection of Photos -->
  <resultMap id="PlaylistResultMap" type="com.mongddang.backend.profile.dto.PlaylistDTO">
    <id property="playlistId" column="playlistId"/>
    <result property="latitude" column="latitude"/>
    <result property="longitude" column="longitude"/>
    <result property="locationAddress" column="locationAddress"/>
    <association property="music" javaType="com.mongddang.backend.profile.dto.MusicDTO" resultMap="MusicResultMap"/>
    <!-- Photo collection: 여러 사진이 있을 수 있으므로 -->
    <collection property="photos" ofType="com.mongddang.backend.profile.dto.PhotoDTO" resultMap="PhotoResultMap"/>
  </resultMap>
  
  <!-- ResultMap for Album with collection of Playlists -->
  <resultMap id="AlbumResultMap" type="com.mongddang.backend.profile.dto.AlbumDTO">
    <id property="albumId" column="albumId"/>
    <result property="title" column="title"/>
    <result property="createdAt" column="albumCreatedAt"/>
    <collection property="playlists" ofType="com.mongddang.backend.profile.dto.PlaylistDTO" resultMap="PlaylistResultMap"/>
  </resultMap>
  
  <!-- Main ResultMap for Profile -->
  <resultMap id="ProfileResultMap" type="com.mongddang.backend.profile.dto.ProfileResponseDTO">
    <id property="userId" column="userId"/>
    <result property="nickname" column="nickname"/>
    <collection property="albums" ofType="com.mongddang.backend.profile.dto.AlbumDTO" resultMap="AlbumResultMap"/>
  </resultMap>
  
  <!-- Query: getProfile -->
  <select id="getProfile" parameterType="int" resultMap="ProfileResultMap">
  SELECT 
      u.user_id as userId,
      u.nickname as nickname,
      
      a.album_id as albumId,
      a.title as title,
      a.created_at as albumCreatedAt,
      
      p.playlist_id as playlistId,
      p.latitude as latitude,
      p.longitude as longitude,
      p.location_address as locationAddress,
      
      m.track_name as trackName,
      m.artist_name as artistName,
      
      ph.photo_id as photoId,
      ph.photo_URL as photoURL,
      ph.created_at as photoCreatedAt
  FROM user u
  LEFT JOIN album a ON u.user_id = a.user_id AND a.status = true
  LEFT JOIN playlist p ON a.album_id = p.album_id
  LEFT JOIN music m ON p.music_id = m.music_id
  RIGHT JOIN photo ph ON p.playlist_id = ph.playlist_id
  -- 파생 테이블을 사용하여 최신 앨범 3개의 album_id를 가져온다.
  LEFT JOIN (
      SELECT album_id
      FROM album
      WHERE user_id = #{userId} AND status = true
      ORDER BY created_at DESC
      LIMIT 3
  ) recentAlbums ON a.album_id = recentAlbums.album_id
  WHERE u.user_id = #{userId}
    AND (a.album_id IS NULL OR recentAlbums.album_id IS NOT NULL)
  ORDER BY a.created_at DESC
</select>
</mapper>
